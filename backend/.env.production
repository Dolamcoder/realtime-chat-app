# =====================================================
# BACKEND - PRODUCTION ENV
# Dùng khi: NODE_ENV=production node server.js
# (Trên server thật: set biến này trong hosting panel,
#  hoặc dùng file .env.production với dotenv-flow)
# =====================================================

NODE_ENV=production

PORT=3000
HOST=0.0.0.0

# Domain frontend của bạn (có thể nhiều, cách nhau dấu phẩy)
CLIENT_URL=https://chat.yourdomain.com

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/chatapp

# Secrets - THAY BẰNG CHUỖI NGẪU NHIÊN DÀI ÍT NHẤT 64 KÝ TỰ
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS
REFRRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET_64_CHARS

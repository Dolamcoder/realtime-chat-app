# =====================================================
# FRONTEND - PRODUCTION ENV
# Dùng khi: npm run build (vite build --mode production)
# =====================================================

# URL tuyệt đối của backend API trên server thật
# Thay "https://api.yourdomain.com" bằng domain backend của bạn
VITE_API_BACKEND_URL=https://api.yourdomain.com/api/v1

# URL của backend để socket.io kết nối
# Thường cùng domain với API
VITE_SOCKET_URL=https://api.yourdomain.com
